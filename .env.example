# Optional production site URL for canonical links & Open Graph absolute URLs
# Example: https://manasgandhi.pages.dev
VITE_SITE_URL=https://your-portfolio.pages.dev

# Web3Forms API Key for direct static edge email delivery (Cloudflare Pages)
VITE_WEB3FORMS_KEY=your-web3forms-access-key

# Optional Contact API SMTP configuration (used for local/serverless Node backend)
# If left unset, the contact form cleanly falls back to Web3Forms or client mailto: action.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-16-character-app-password
CONTACT_TO=your-email@gmail.com
